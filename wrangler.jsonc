{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naejeon-v2",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  // 화면은 정적 파일로 함께 배포한다. /api/* 만 Worker가 처리하고 나머지 주소는 index.html로 보낸다.
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ---------------------------------------------------------------------------
  // 여기(맨 위)는 로컬 개발·테스트용이다. 운영은 아래 env.production을 쓴다:
  //   npm run deploy:production   (배포 전 점검 scripts/predeploy-check.mjs → 빌드 → wrangler deploy --env production)
  // --env 없이 wrangler deploy를 하면 이 로컬 설정(AUTH_MODE=fake, D1 ID 0000…)이 올라가려 한다.
  // 배포 순서와 비밀값 목록은 docs/배포안내.md에 있다.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naejeon",
      // 로컬 개발용 자리 표시값이다. 운영 DB ID는 env.production에 넣는다.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 자동 백업(src/server/backupCron.ts)을 넣는 R2 버킷. 로컬·테스트에서는 wrangler/miniflare가 흉내 낸다.
  // 바인딩(r2_buckets·version_metadata·vars)은 env.*로 이어지지 않으므로 환경마다 다시 적는다.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "naejeon-local-backups" }],
  // 배포 버전 정보. 스냅숏 ETag에 넣어, 새 코드를 배포하면 예전 응답 본문을 다시 쓰지 않게 한다(src/server/snapshot.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 예정 작업(Cron Trigger, UTC). 18~20시 UTC = 한국 03:00~05:55, 5분마다(하루 36번, 트리거 1개).
  // 한 번에 모임 BACKUP_GROUPS_PER_RUN개(기본 5)까지 백업하고, 오늘 끝나지 않은 모임은 다음 실행이 잇는다.
  // 무료 요금제는 예정 작업도 실행당 CPU 10ms이고 계정당 크론 트리거 5개까지다(docs/배포안내.md).
  "triggers": { "crons": ["*/5 18-20 * * *"] },
  "vars": {
    // "fake"는 로컬·테스트 전용 로그인이다. 운영(env.production)은 "oauth"다.
    // 가짜 로그인과 테스트 훅(/api/test/*)은 허용 목록으로만 열린다: AUTH_MODE=fake 이고 DEPLOY_ENV=local 이고
    // 요청 주소가 localhost·127.0.0.1·[::1]·*.test일 때만(src/server/auth.ts). 이 설정이 실수로 공개 주소에
    // 올라가도(--env production 빠뜨림) 공개 주소에서는 열리지 않는다.
    "AUTH_MODE": "fake",
    "DEPLOY_ENV": "local",
    // 비밀번호 페퍼의 로컬 전용 값(src/server/local.ts). 로컬 개발·테스트(vitest)·브라우저 테스트가 이 값을 쓴다.
    // 운영·staging은 이 값을 물려받지 않는다(vars는 env.*로 이어지지 않음). 거기서는 wrangler secret으로 넣고,
    // 없으면 서버가 모든 API를 거절한다(src/server/auth.ts productionConfigProblem).
    "PASSWORD_PEPPER": "local-only-password-pepper-not-for-production",
    // 로컬에서는 합성 데이터 넣기(npm run seed)와 브라우저 테스트가 한도에 걸리지 않게 넉넉히 둔다.
    "RATE_WINDOW_SECONDS": "60",
    "RATE_WRITE_PER_ACCOUNT": "5000",
    "RATE_WRITE_PER_IP": "5000",
    "RATE_AUTH_PER_IP": "5000",
    "RATE_VIEW_PER_IP": "5000",
    "RATE_HEAVY_PER_ACCOUNT": "5000",
    "RATE_HEAVY_PER_IP": "5000",
    "RATE_SNAPSHOT_PER_ACCOUNT": "5000",
    "RATE_SNAPSHOT_PER_IP": "5000",
    "RATE_SIGNUP_PER_IP": "5000",
    "RATE_LOGIN_PER_IP": "5000",
    "RATE_RECOVER_PER_IP": "5000",
    "RATE_CLIENT_ERROR_PER_IP": "5000",
    // 대량 쓰기 하루 예산(경기 수, UTC 하루). 로컬 합성 데이터·브라우저 테스트가 걸리지 않게 넉넉히.
    "RATE_BULK_ROWS_PER_ACCOUNT": "1000000",
    "RATE_BULK_ROWS_PER_IP": "1000000",
    // IP 하루 벌점·스냅숏 하루 읽기 예산도 로컬에서는 걸리지 않게 넉넉히.
    "RATE_STRIKES_PER_IP_DAY": "1000000",
    "RATE_SNAPSHOT_ROWS_PER_ACCOUNT_DAY": "1000000000",
    "RATE_SNAPSHOT_ROWS_PER_IP_DAY": "1000000000",
    "RATE_SNAPSHOT_ROWS_PER_TOKEN_DAY": "1000000000",
    // 사이트 운영자(현황 화면 #/admin). 로컬 전용 꼴 "fake:로그인이름": 가짜 로그인 "e2e-site-admin"이 사이트 운영자다
    // (브라우저 테스트 e2e/error-admin.spec.ts가 쓴다). 가짜 로그인이 닫힌 곳에서는 이 꼴을 무시한다(src/server/siteAdmin.ts).
    "SITE_ADMIN_ACCOUNT_IDS": "fake:e2e-site-admin"
  },
  "env": {
    "production": {
      // 운영 Worker 이름. 주소는 https://naejeon-v2-production.<계정>.workers.dev 또는 연결한 도메인.
      "name": "naejeon-v2-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "naejeon-prod",
          // 2026-11-10 `npx wrangler d1 create naejeon-prod`로 만듦(APAC).
          "database_id": "28a43b07-de8a-492f-b177-f0133a40415f",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AUTH_MODE": "oauth",
        // 이 값이 있으면 AUTH_MODE=fake나 빠진 비밀값을 서버가 거절한다(src/server/auth.ts).
        "DEPLOY_ENV": "production",
        // 실제 서비스 주소(https). OAuth 리디렉션 URI가 이 주소 + /api/auth/{kakao|google}/callback 이다.
        // 지금은 workers.dev 기본 주소. 도메인을 연결하면 여기를 바꾸고 다시 배포한다.
        "PUBLIC_ORIGIN": "https://naejeon-v2-production.guseong-family.workers.dev",
        "SESSION_TTL_HOURS": "720",
        "RATE_WINDOW_SECONDS": "60",
        "RATE_WRITE_PER_ACCOUNT": "60",
        "RATE_WRITE_PER_IP": "120",
        "RATE_AUTH_PER_IP": "20",
        // 조회 링크·참가 신청 등 로그인 없는 읽기(2026-11-07: 120 → 30). 화면은 탭으로 돌아올 때마다 다시 읽고, 바뀌지 않았으면
        // 304라 읽기 비용은 작지만 요청 수 제한 자체가 요청마다 D1 쓰기 1행을 쓴다(무료 하루 10만 행).
        "RATE_VIEW_PER_IP": "30",
        // 비싼 읽기(백업 내려받기·합치기 미리보기·가져오기 지문 목록).
        "RATE_HEAVY_PER_ACCOUNT": "60",
        "RATE_HEAVY_PER_IP": "120",
        // 운영자·멤버 스냅숏 중 본문을 만드는 200(304는 세지 않음, 2026-11-09). D1 하루 읽기(500만 행) 보호.
        // 쓰기 한도(60)와 같게: 저장마다 다시 읽기가 200이라 더 작으면 저장 뒤 다시 읽기만 429가 난다.
        "RATE_SNAPSHOT_PER_ACCOUNT": "60",
        "RATE_SNAPSHOT_PER_IP": "120",
        // 자체 계정(아이디 + 비밀번호) 경로의 IP별 한도. 아이디별 틀린 시도 제한(15분에 로그인 10·복구 5)은
        // 코드에 고정이다(src/server/local.ts). 자체 계정을 끄려면 "LOCAL_ACCOUNTS": "off"를 더한다.
        "RATE_SIGNUP_PER_IP": "5",
        "RATE_LOGIN_PER_IP": "10",
        "RATE_RECOVER_PER_IP": "5",
        // 비밀번호 해시 반복 횟수. 무료 요금제(요청당 CPU 10ms) 대응으로 20000. 서버 비밀값 페퍼(HMAC)를 먼저 씌우므로
        // DB만 새어서는 추측할 수 없다(src/server/local.ts). Paid로 올리면 "100000"으로 바꾼다(다음 로그인 때 다시 저장된다).
        "PASSWORD_PBKDF2_ITERATIONS": "20000",
        // 화면 오류 보고(로그인 없음)의 IP별 한도.
        "RATE_CLIENT_ERROR_PER_IP": "10",
        // 대량 쓰기 하루 예산: 가져오기·지난 경기 입력·백업 복원으로 넣는 경기 수(UTC 하루, src/server/ratelimit.ts).
        "RATE_BULK_ROWS_PER_ACCOUNT": "3000",
        "RATE_BULK_ROWS_PER_IP": "6000",
        // IP 하루 벌점: 분 단위 한도에 걸린 창이 하루(UTC) 이만큼이면 그 IP는 한국 시각 다음 오전 9시까지 429다.
        // 여럿이 한 IP를 나눠 쓰는 저녁(PC방·같은 와이파이)에 몇 번 걸리는 것은 정상이라 넉넉히 둔다.
        "RATE_STRIKES_PER_IP_DAY": "20",
        // 스냅숏 200의 하루 읽기 예산(읽은 행 수 추정 = 300 + 경기 수 × 13, src/server/ratelimit.ts snapshotCost).
        // D1 무료 하루 읽기 500만 행을 한 계정·한 IP·한 조회 링크가 혼자 다 쓰지 못하게 한다. 정상 사용 추정은
        // 100경기 모임 저녁 약 40만 행, 522경기 모임 약 200만 행(docs/개선-서버-2026-11-10.md).
        "RATE_SNAPSHOT_ROWS_PER_ACCOUNT_DAY": "3000000",
        "RATE_SNAPSHOT_ROWS_PER_IP_DAY": "4000000",
        "RATE_SNAPSHOT_ROWS_PER_TOKEN_DAY": "4000000",
        // 자동 백업: 예정 작업 한 번에 백업할 모임 수, 보관 날수(src/server/backupCron.ts).
        "BACKUP_GROUPS_PER_RUN": "5",
        "BACKUP_KEEP_DAYS": "30",
        // 사이트 운영자(현황 화면 #/admin)의 계정 ID. 쉼표로 여러 명. 비어 있으면 아무도 못 본다.
        // 내 계정 ID는 로그인한 뒤 주소창에 /api/me 를 열면 accountId로 보인다(docs/배포안내.md).
        // 2026-11-11: 조규성 자체 계정.
        "SITE_ADMIN_ACCOUNT_IDS": "9f8f33e2-540a-4baa-9623-d20549fefee5"
      },
      // [만들어야 함] npx wrangler r2 bucket create naejeon-prod-backups (docs/배포안내.md 13-4절)
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "naejeon-prod-backups" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "triggers": { "crons": ["*/5 18-20 * * *"] },
      // Workers Logs: console.log·console.error와 요청 기록을 Cloudflare 대시보드에서 본다(무료 요금제 하루 20만 줄, 3일 보관).
      // 형식은 공식 문서(https://developers.cloudflare.com/workers/observability/logs/workers-logs/)에서 2026-11-06에 확인.
      // 실행 기록(invocation logs)은 끈다(2026-11-10 보안 감사, 키 이름은 같은 문서에서 확인). 실행 기록에는 요청 주소가
      // 그대로 남아 조회 링크·참가 신청 링크의 권한 토큰이 대시보드에 평문으로 쌓인다. 우리 console 로그는 토큰을 가린다
      // (src/server/http.ts pathForLog). staging은 배포 뒤 요청별 CPU 시간을 봐야 해서 켜 둔다.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "invocation_logs": false }
      }
      // 비밀값(wrangler secret put ... --env production): SESSION_SECRET, PASSWORD_PEPPER(둘은 서로 다른 값, 각 32자 이상),
      // KAKAO_CLIENT_ID, KAKAO_CLIENT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
    },
    // -------------------------------------------------------------------------
    // 시험 환경(staging). 운영과 같은 설정·같은 안전장치(DEPLOY_ENV=production)로 따로 띄운다.
    // 순서: staging 배포 → 마이그레이션 → 스파이크·손 확인 → production(docs/배포안내.md 8-1절).
    //   npm run deploy:staging
    // 비밀값도 따로 넣는다(wrangler secret put ... --env staging): SESSION_SECRET, PASSWORD_PEPPER. 운영과 다른 값을 쓴다.
    // -------------------------------------------------------------------------
    "staging": {
      "name": "naejeon-v2-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "naejeon-staging",
          // [채워야 함] `npx wrangler d1 create naejeon-staging`가 알려주는 database_id.
          "database_id": "f1e678df-725f-4a4a-8039-21e314b687e9",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AUTH_MODE": "oauth",
        "DEPLOY_ENV": "production",
        // [채워야 함] staging 주소(https). 예: https://naejeon-v2-staging.<계정>.workers.dev
        "PUBLIC_ORIGIN": "https://naejeon-v2-staging.guseong-family.workers.dev",
        "SESSION_TTL_HOURS": "720",
        "RATE_WINDOW_SECONDS": "60",
        "RATE_WRITE_PER_ACCOUNT": "60",
        "RATE_WRITE_PER_IP": "120",
        "RATE_AUTH_PER_IP": "20",
        "RATE_VIEW_PER_IP": "30",
        "RATE_HEAVY_PER_ACCOUNT": "60",
        "RATE_HEAVY_PER_IP": "120",
        "RATE_SNAPSHOT_PER_ACCOUNT": "60",
        "RATE_SNAPSHOT_PER_IP": "120",
        "RATE_SIGNUP_PER_IP": "5",
        "RATE_LOGIN_PER_IP": "10",
        "RATE_RECOVER_PER_IP": "5",
        "PASSWORD_PBKDF2_ITERATIONS": "20000",
        "RATE_CLIENT_ERROR_PER_IP": "10",
        // 대량 쓰기 하루 예산: 가져오기·지난 경기 입력·백업 복원으로 넣는 경기 수(UTC 하루, src/server/ratelimit.ts).
        "RATE_BULK_ROWS_PER_ACCOUNT": "3000",
        "RATE_BULK_ROWS_PER_IP": "6000",
        "RATE_STRIKES_PER_IP_DAY": "20",
        "RATE_SNAPSHOT_ROWS_PER_ACCOUNT_DAY": "3000000",
        "RATE_SNAPSHOT_ROWS_PER_IP_DAY": "4000000",
        "RATE_SNAPSHOT_ROWS_PER_TOKEN_DAY": "4000000",
        "BACKUP_GROUPS_PER_RUN": "5",
        "BACKUP_KEEP_DAYS": "30",
        "SITE_ADMIN_ACCOUNT_IDS": ""
      },
      // [만들어야 함] npx wrangler r2 bucket create naejeon-staging-backups
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "naejeon-staging-backups" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // 크론은 계정당 5개까지라 staging은 하루 한 번만 돈다(한 번에 BACKUP_GROUPS_PER_RUN개).
      "triggers": { "crons": ["0 18 * * *"] },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
